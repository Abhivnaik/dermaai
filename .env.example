# Copy this file to .env and fill in your own values. Never commit .env.

# Required for the AI assistant and the knowledge-library search
# (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Gemini chat models (defaults shown)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: embedding model for the knowledge library (default shown).
# Changing it requires rebuilding the index: python -m rag.ingest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: comma-separated origins allowed to call the API from a browser.
# Not needed in development (the Vite dev server proxies /api).
# CORS_ORIGINS=https://your-frontend.example.org
